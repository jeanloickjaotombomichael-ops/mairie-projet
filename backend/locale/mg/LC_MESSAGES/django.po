#: agents/assistant.py:140
#, python-format
msgid ""
"Je suis l'assistant de l'application. Je ne connais que les demandes et "
"documents de %(where)s. Exemples :"
msgstr ""
"Izaho no mpanampy amin'ity rindranasa ity. Ny fangatahana sy antontan-"
"taratasin'ny %(where)s ihany no fantatro. Ohatra (amin'ny teny frantsay):"

#: agents/assistant.py:141
msgid "votre guichet"
msgstr "ny varavarankelinao"

#: agents/assistant.py:141
msgid "tous les guichets"
msgstr "varavarankely rehetra"

#: agents/assistant.py:142
msgid "• « Quelle est la prochaine demande à traiter ? »"
msgstr "• « Quelle est la prochaine demande à traiter ? »"

#: agents/assistant.py:143
msgid "• « Combien de demandes en attente ? »"
msgstr "• « Combien de demandes en attente ? »"

#: agents/assistant.py:144
msgid "• « Montre la demande MV-2026-000012 » ou « la demande de Rabe »"
msgstr "• « Montre la demande MV-2026-000012 » na « la demande de Rabe »"

#: agents/assistant.py:145
msgid "• « Prends en charge la prochaine demande à ma place »"
msgstr "• « Prends en charge la prochaine demande à ma place »"

#: agents/assistant.py:146
msgid ""
"• « Approuve cette demande : votre acte est prêt » / « Refuse la demande de "
"Rabe motif : pièce manquante »"
msgstr ""
"• « Approuve cette demande : votre acte est prêt » / « Refuse la demande de "
"Rabe motif : pièce manquante »"

#: agents/assistant.py:149
msgid "• « Établis l'acte de la prochaine demande »"
msgstr "• « Établis l'acte de la prochaine demande »"

#: agents/assistant.py:151
msgid "• « Y a-t-il des fraudes ? » · « Demandes d'accès agent en attente ? »"
msgstr ""
"• « Y a-t-il des fraudes ? » · « Demandes d'accès agent en attente ? »"

#: agents/assistant.py:157
msgid ""
"Je ne peux pas vous aider pour cela : je réponds seulement aux questions sur"
" l'application (demandes, documents, guichets) et j'effectue les tâches de "
"cette page. Tapez « aide » pour des exemples."
msgstr ""
"Tsy afaka manampy anao amin'izany aho: ny fanontaniana momba ny rindranasa "
"ihany (fangatahana, antontan-taratasy, varavarankely) no valiako ary ny asa "
"amin'ity pejy ity no ataoko. Soraty « aide » raha hahita ohatra."

#: agents/assistant.py:169
#, python-format
msgid ""
"Demandes : %(total)s au total — %(new_today)s aujourd'hui, %(new_week)s "
"cette semaine."
msgstr ""
"Fangatahana: %(total)s raha atambatra — %(new_today)s androany, %(new_week)s"
" tamin'ity herinandro ity."

#: agents/assistant.py:181
#, python-format
msgid "Documents officiels établis : %(count)s."
msgstr "Antontan-taratasy ofisialy natao: %(count)s."

#: agents/assistant.py:189
#, python-format
msgid "Par type : %(list)s."
msgstr "Araka ny karazany: %(list)s."

#: agents/assistant.py:209
msgid "Aucune demande en attente : tout est à jour."
msgstr "Tsy misy fangatahana miandry: vita daholo."

#: agents/assistant.py:212
#, python-format
msgid ""
"%(count)s demande(s) en attente. À traiter en premier (ordre d'arrivée) :"
msgstr ""
"Fangatahana %(count)s miandry. Karakaraina voalohany (araka ny filaharana):"

#: agents/assistant.py:220 templates/admin/index.html:87
#: templates/agents/_requests_table.html:23
#: templates/agents/notifications.html:30
msgid "Aucune demande pour le moment."
msgstr "Tsy mbola misy fangatahana."

#: agents/assistant.py:221
msgid "Les dernières demandes reçues :"
msgstr "Ireo fangatahana farany voaray:"

#: agents/assistant.py:232
#, python-format
msgid ""
"%(total)s document(s) contrôlé(s) : %(altered)s altéré(s), %(deletions)s "
"suppression(s) demandée(s)."
msgstr ""
"Antontan-taratasy %(total)s voamarina: %(altered)s novaina, %(deletions)s "
"nangatahina hofafana."

#: agents/assistant.py:239
msgid "Ouvrir « Sécurité et fraude »"
msgstr "Sokafy « Fiarovana sy hosoka »"

#: agents/assistant.py:250
#, python-format
msgid "%(count)s demande(s) d'accès agent en attente de votre validation."
msgstr "Fangatahana fidirana mpiasa %(count)s miandry ny fankatoavanao."

#: agents/assistant.py:251
msgid "Ouvrir les demandes d'accès agent"
msgstr "Sokafy ny fangatahana fidirana mpiasa"

#: agents/assistant.py:263
#, python-format
msgid "%(count)s message(s) de contact non traité(s)."
msgstr "Hafatra fifandraisana %(count)s tsy mbola voakarakara."

#: agents/assistant.py:264
msgid "Ouvrir les messages de contact"
msgstr "Sokafy ny hafatra fifandraisana"

#: agents/assistant.py:307
msgid ""
"Je ne trouve pas la demande. Donnez sa référence (ex. MV-2026-000012), le "
"nom de l'usager, ou dites « la prochaine demande »."
msgstr ""
"Tsy hitako ilay fangatahana. Omeo ny laharany (ohatra MV-2026-000012), ny "
"anaran'ny olom-pirenena, na lazao hoe « la prochaine demande »."

#: agents/assistant.py:311
msgid "Plusieurs demandes correspondent. Précisez la référence :"
msgstr "Fangatahana maromaro no mifanaraka. Lazao ny laharany:"

#: agents/assistant.py:334 agents/assistant.py:362 agents/assistant.py:472
msgid "Votre compte ne permet pas de modifier les demandes."
msgstr "Tsy afaka manova fangatahana ny kaontinao."

#: agents/assistant.py:343
#, python-format
msgid ""
"Je vais passer la demande %(reference)s (%(person)s) au statut « %(status)s "
"»."
msgstr "Hovaiko ho « %(status)s » ny fangatahana %(reference)s (%(person)s)."

#: agents/assistant.py:347
#, python-format
msgid "Message envoyé à l'usager : « %(message)s »"
msgstr "Hafatra halefa amin'ny olom-pirenena: « %(message)s »"

#: agents/assistant.py:349
msgid "Astuce : ajoutez « motif : … » pour expliquer le refus à l'usager."
msgstr ""
"Torohevitra: ampio « motif : … » hanazavana ny fandavana amin'ny olom-"
"pirenena."

#: agents/assistant.py:351
msgid "Confirmez-vous ?"
msgstr "Hamafisinao ve?"

#: agents/assistant.py:360
msgid ""
"Écrivez le message après deux-points, ex. « Réponds à cette demande : votre "
"dossier est prêt »"
msgstr ""
"Soraty aorian'ny teboka roa ny hafatra, ohatra « Réponds à cette demande : "
"votre dossier est prêt »"

#: agents/assistant.py:371
#, python-format
msgid ""
"Je vais envoyer ce message à %(person)s (demande %(reference)s) : « "
"%(message)s ». Confirmez-vous ?"
msgstr ""
"Halefako amin'i %(person)s (fangatahana %(reference)s) ity hafatra ity: « "
"%(message)s ». Hamafisinao ve?"

#: agents/assistant.py:386 agents/views.py:379
msgid "Ce guichet n'établit pas de documents officiels."
msgstr "Tsy mamoaka antontan-taratasy ofisialy ity varavarankely ity."

#: agents/assistant.py:393
#, python-format
msgid ""
"Le formulaire est pré-rempli avec les informations de la demande "
"%(reference)s : vérifiez-le, complétez-le puis enregistrez pour sceller le "
"document."
msgstr ""
"Efa nofenoina mialoha amin'ny mombamomba ny fangatahana %(reference)s ny "
"taratasy: hamarino, fenoy ary tehirizo mba hisian'ny tombo-kase."

#: agents/assistant.py:404
msgid "Demandes trouvées :"
msgstr "Fangatahana hita:"

#: agents/assistant.py:407
#, python-format
msgid "Demande %(reference)s — %(type)s, déposée le %(date)s par %(person)s."
msgstr ""
"Fangatahana %(reference)s — %(type)s, napetrak'i %(person)s ny %(date)s."

#: agents/assistant.py:411
#, python-format
msgid "Statut : %(status)s."
msgstr "Sata: %(status)s."

#: agents/assistant.py:416
#, python-format
msgid "À traiter après %(reference)s (ordre d'arrivée)."
msgstr "Karakaraina aorian'ny %(reference)s (araka ny filaharana)."

#: agents/assistant.py:417
msgid "C'est la prochaine demande de ce type à traiter."
msgstr "Ity no fangatahana manaraka amin'ity karazana ity hokarakaraina."

#: agents/assistant.py:420
#, python-format
msgid "Réponse déjà envoyée : « %(message)s »"
msgstr "Valiny efa nalefa: « %(message)s »"

#: agents/assistant.py:428
msgid "L'assistant est réservé aux agents et aux administrateurs."
msgstr "Natokana ho an'ny mpiasa sy mpitantana ny mpanampy."

#: agents/assistant.py:470
msgid "Action inconnue."
msgstr "Hetsika tsy fantatra."

#: agents/assistant.py:475
msgid "Je ne trouve pas la demande."
msgstr "Tsy hitako ilay fangatahana."

#: agents/assistant.py:485
#, python-format
msgid "Action impossible : %(errors)s"
msgstr "Tsy azo atao: %(errors)s"

#: agents/assistant.py:488
#, python-format
msgid "C'est fait : la demande %(reference)s est maintenant « %(status)s »."
msgstr "Vita: « %(status)s » izao ny fangatahana %(reference)s."

#: agents/forms.py:36
msgid "Identifiant ou mot de passe incorrect."
msgstr "Diso ny anarana fidirana na ny teny miafina."

#: agents/forms.py:38
