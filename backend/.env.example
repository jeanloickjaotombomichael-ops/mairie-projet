# Copiez ce fichier en « .env » puis adaptez les valeurs.
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=changez-moi
DOCUMENT_SIGNING_KEY=changez-moi-aussi
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Base de données PostgreSQL (facultatif : SQLite si POSTGRES_DB est absent) ---
# POSTGRES_DB=mairy
# POSTGRES_USER=mairy
# POSTGRES_PASSWORD=changez-moi
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Espace usager : authentification Clerk -------------------------------
# Même clé publique que VITE_CLERK_PUBLISHABLE_KEY du frontend (Dashboard Clerk
# > API Keys). L'émetteur du jeton et l'URL des clés publiques en sont déduits.
# CLERK_PUBLISHABLE_KEY=pk_test_...
#
# Alternative : renseigner directement l'émetteur (Frontend API URL de Clerk).
# CLERK_ISSUER=https://votre-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://votre-instance.clerk.accounts.dev/.well-known/jwks.json
#
# Optionnel : origines autorisées (revendication « azp » du jeton), séparées par des virgules.
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Envoi des e-mails depuis « Mail » (ex. Gmail : smtp.gmail.com + mot de passe d'application)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=
